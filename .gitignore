# ============================================================
# AI-COMPANY .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# --- Environment & Secrets ---
.env
.env.local
.env.production
.env.staging
*.pem
*.key
secrets/

# --- Database & SQLite ---
data/*.db
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/
*.log.*

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- IDE & Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docker ---
docker-compose.override.yml

# --- Agent Sandboxes & Workspaces ---
workspace/sandbox/

# --- Compiled tools (generated at runtime) ---
# Keep tools_data/ tracked but ignore .pyc inside
tools_data/__pycache__/
tools_data/*.pyc

# --- Mypy ---
.mypy_cache/
.dmypy.json
dmypy.json

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Distribution ---
*.tar.gz
*.zip
