# AI-COMPANY Environment Configuration

# Environment mode: 'development' or 'production'
ENV=development
DEBUG=false

# Web Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (defaults to local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_company
DATABASE_URL=sqlite:///data/company.db

# Task Queue (defaults to in-memory queue; optional Redis)
# REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_QUEUE=true

# LLM Provider: 'mock' (default offline simulation), 'openai', 'gemini', 'anthropic', 'ollama'
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Autonomous Execution Engine
AUTO_CYCLE_ENABLED=true
AUTONOMOUS_CYCLE_INTERVAL_SECONDS=15
SCHEDULER_INTERVAL_SECONDS=10

# Multi-Platform Operations (Telegram, LinkedIn, Facebook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
